<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.pedmn.mnagentpipeline2</groupId>
        <artifactId>mnagentpipeline2-parent</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../../../../pom.xml</relativePath>
    </parent>
    <artifactId>mnagentpipeline2-common-service-integration</artifactId>
    <name>common-service-integration</name>
    <description>集成层：DRM/Nacos 等基础设施能力，供上层 module 依赖</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- 版本由 parent 的 dependencyManagement 统一管理，这里不写 version -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- 仅用 Spring 的注解（@Component/@ConfigurationProperties/@PostConstruct 等），
             不引入 web，保持底层 module 轻量 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
        </dependency>
    </dependencies>

</project>
